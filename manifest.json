{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "1.0.0",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "minimum_chrome_version": "116",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "sidePanel",
        "debugger"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Website Page Auditor",
        "default_icon": {
            "16": "icons/main.png",
            "32": "icons/main.png",
            "48": "icons/main.png",
            "128": "icons/main.png"
        }
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "icons": {
        "16": "icons/main.png",
        "32": "icons/main.png",
        "48": "icons/main.png",
        "128": "icons/main.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}
